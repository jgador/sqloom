<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>sqloom</PackageId>
    <ToolCommandName>sqloom</ToolCommandName>
    <Authors>Sqloom contributors</Authors>
    <Description>CLI for replaying API requests, correlating SQL with Query Store, and generating tuning advice.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jgador/sqloom</PackageProjectUrl>
    <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>
    <PackageTags>sqloom;performance;tuning;query-store;aspnetcore;dotnet-tool</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryUrl>https://github.com/jgador/sqloom</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.SqlServer.DacFx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sqloom.Testing\Sqloom.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PackageReadme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\.agents\skills\sqloom\**\*">
      <LogicalName>Sqloom.Host.InitAssets/skills/sqloom/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
